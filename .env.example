# AI-Content-Generation Studio Environment Configuration
# Copy this file to .env and populate with your personal API keys

# Google Gemini API (Text & TTS Narration)
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudflare Workers AI (FLUX.1 Schnell Keyframe Generation)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# Kaggle API (Video Diffusion on GPU T4)
KAGGLE_USERNAME=your_kaggle_username_here
KAGGLE_KEY=your_kaggle_api_token_here
KAGGLE_API_TOKEN=your_kaggle_api_token_here
